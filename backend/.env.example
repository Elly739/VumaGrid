# Copy values into the process environment for local development.
VUMAGRID_DB_PATH=./vumagrid.db
VUMAGRID_API_URL=http://127.0.0.1:8013
VUMAGRID_DEMO_MODE=false
VUMAGRID_SIMULATION_SCENARIO=normal
VUMAGRID_SIMULATION_SEED=42
VUMAGRID_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Used only by local demo mode. Production webhook destinations must be tenant-scoped.
VUMAGRID_ALERTS_WEBHOOK=
# Production mode: map opaque operator bearer tokens to the tenant IDs they may read.
# Example: {"replace-with-a-long-random-secret":["ORG-UPTOWN-HEALTHCARE"]}
VUMAGRID_ACCESS_TOKENS=
# Production mode: map opaque device bearer tokens to the tenant IDs they may ingest for.
# Example: {"replace-with-a-different-long-random-secret":"ORG-UPTOWN-HEALTHCARE"}
VUMAGRID_INGESTION_TOKENS=
# Production mode: map each tenant to its own alert destination.
# Example: {"ORG-UPTOWN-HEALTHCARE":"https://alerts.example/tenant-endpoint"}
VUMAGRID_ALERTS_WEBHOOKS=
